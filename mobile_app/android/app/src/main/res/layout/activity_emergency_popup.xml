<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:gravity="center"
    android:padding="24dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Emergency Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESQ AI"
            android:textColor="#FFFF0000"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.15"
            android:layout_marginBottom="24dp" />

        <!-- Emergency Title -->
        <TextView
            android:id="@+id/tvEmergencyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY DETECTED"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Divider -->
        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="#FFFF0000"
            android:layout_marginBottom="24dp" />

        <!-- Are You Alright -->
        <TextView
            android:id="@+id/tvAreYouAlright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARE YOU ALRIGHT?"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Countdown Timer -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00"
            android:textColor="#FFFF0000"
            android:textSize="56sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- Countdown Label -->
        <TextView
            android:id="@+id/tvCountdownLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-confirm in:"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="40dp" />

        <!-- I'M OK Button -->
        <Button
            android:id="@+id/btnImOk"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:text="I'M OK"
            android:textColor="#FF000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/btn_emergency_ok"
            android:textAllCaps="false" />

        <!-- I NEED HELP Button -->
        <Button
            android:id="@+id/btnINeedHelp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="I NEED HELP"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/btn_emergency_help"
            android:textAllCaps="false" />

    </LinearLayout>

</RelativeLayout>
