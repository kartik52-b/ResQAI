<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while the Flutter
         engine initializes, as well as behind your Flutter UI while its running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Emergency Popup: full-screen, shows over lock screen, no title bar.

         CRITICAL: EmergencyPopupActivity extends AppCompatActivity, so this
         theme MUST be an AppCompat descendant. A platform theme here crashes
         the whole app with "IllegalStateException: You need to use a
         Theme.AppCompat theme (or descendant) with this activity" the moment
         the emergency popup launches (see crash-log.txt).
         The popup layout draws its own opaque background, so the dark
         AppCompat window background is never visible. -->
    <style name="EmergencyPopupTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">#E6000000</item>
        <item name="android:navigationBarColor">#E6000000</item>
    </style>
</resources>
